# Copy to `.env` and fill in locally. Never commit `.env`.
# In production these values come from Google Cloud Secret Manager and
# are injected into the Cloud Run service at deploy time.

# ---- Identity / environment ------------------------------------------------
FIREBASE_PROJECT_ID=vanij-6cc7e
ENVIRONMENT=dev
APP_VERSION=0.1.0

# ---- HTTP / CORS -----------------------------------------------------------
# Comma-separated list of origins permitted by CORS. NEVER use "*".
ALLOWED_ORIGINS=https://vanij.app

# ---- Auth ------------------------------------------------------------------
# Local-dev only: when "true", skips Firebase token verification and
# pins request.state.uid to AUTH_TEST_UID. Forbidden in production; the
# app will 401 if ENVIRONMENT=prod and AUTH_DISABLED=true.
AUTH_DISABLED=false
AUTH_TEST_UID=test-merchant-uid

# Service-account JSON path used by firebase-admin for Application Default
# Credentials. Populated by Cloud Run automatically in prod; for local dev
# point this at a downloaded service-account key (and NEVER commit it).
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---- Rate limiting ---------------------------------------------------------
# SlowAPI syntax. Applied to all AI routes.
DEFAULT_RATE_LIMIT=60/minute

# ---- External APIs (Sprint 7+) --------------------------------------------
CLAUDE_API_KEY=
