# Copy to `.env` and fill in locally. Never commit `.env`.
# In production these values come from Google Cloud Secret Manager and are
# injected into the Cloud Run service at deploy time.

# Comma-separated list of origins permitted by CORS. NEVER use "*".
ALLOWED_ORIGINS=https://vanij.app

# Firebase project ID — used by firebase-admin when verifying ID tokens.
FIREBASE_PROJECT_ID=vanij-6cc7e

# Claude Sonnet API key (Anthropic). Used from Sprint 7 onwards.
CLAUDE_API_KEY=
