# Copy to `.env` and fill in locally. Never commit `.env`.
# In production these values come from Google Cloud Secret Manager.

# URL of the FastAPI AI backend (Cloud Run). Used by functions that proxy
# requests into the AI service (e.g. the LLM agent trigger in Sprint 7).
PYTHON_BACKEND_URL=

# Claude Sonnet API key — injected into the AI backend in Sprint 7.
# Never inject this directly into Cloud Functions; the functions call the
# AI backend, which holds the key.
CLAUDE_API_KEY=

# Razorpay API keys — used in Sprint 5 for finance reconciliation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
